{
    "name": "solverr/solverr-php",
    "description": "Server SDK for the Solverr crypto payment API.",
    "type": "library",
    "license": "MIT",
    "keywords": ["solverr", "payments", "crypto", "checkout", "webhooks"],
    "homepage": "https://github.com/forcequitx/solverr-php",
    "support": {
        "issues": "https://github.com/forcequitx/solverr/issues",
        "source": "https://github.com/forcequitx/solverr-php"
    },
    "require": {
        "php": ">=8.3",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "12.5.43"
    },
    "autoload": {
        "psr-4": {
            "Solverr\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Solverr\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
