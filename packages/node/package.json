{
  "name": "solverr-node",
  "version": "0.1.0",
  "description": "Server SDK for the Solverr crypto payment API.",
  "license": "MIT",
  "homepage": "https://github.com/forcequitx/solverr/tree/main/packages/node#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forcequitx/solverr.git",
    "directory": "packages/node"
  },
  "bugs": {
    "url": "https://github.com/forcequitx/solverr/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
