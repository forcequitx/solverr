{
  "name": "solverr-x402",
  "version": "0.1.2",
  "description": "x402 v2 paywall middleware that charges AI agents through Solverr invoices or standard exact USDC payments on Base, Ethereum, Arbitrum, Polygon or Avalanche, for Next.js route handlers and Express.",
  "license": "MIT",
  "homepage": "https://github.com/forcequitx/solverr/tree/main/packages/x402#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forcequitx/solverr.git",
    "directory": "packages/x402"
  },
  "bugs": {
    "url": "https://github.com/forcequitx/solverr/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "x402",
    "solverr",
    "near-intents",
    "base",
    "usdc",
    "payments",
    "ai-agents",
    "paywall"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@x402/core": "2.30.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
