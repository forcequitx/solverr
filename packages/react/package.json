{
  "name": "solverr-react",
  "version": "0.1.0",
  "description": "React pay button that opens the Solverr crypto checkout page, or an overlay if you choose.",
  "license": "MIT",
  "homepage": "https://github.com/forcequitx/solverr/tree/main/packages/react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forcequitx/solverr.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/forcequitx/solverr/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "solverr-embed": "0.1.0"
  },
  "peerDependencies": {
    "react": ">=18 <20"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
