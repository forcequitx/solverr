{
  "name": "solverr-embed",
  "version": "0.1.0",
  "description": "Pay buttons for any web page that open the Solverr crypto checkout page, or an overlay if you choose.",
  "license": "MIT",
  "homepage": "https://github.com/forcequitx/solverr/tree/main/packages/embed#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forcequitx/solverr.git",
    "directory": "packages/embed"
  },
  "bugs": {
    "url": "https://github.com/forcequitx/solverr/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "core": [
        "./dist/core.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "!dist/embed.js"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
