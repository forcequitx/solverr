# Postgres (matches deploy/docker-compose.dev.yml). On Vercel: PgBouncer on the VPS's public host, without sslmode, with the password
# from deploy/pgbouncer.env, such as postgresql://solverr_web:<SOLVERR_WEB_DB_PASSWORD>@db.example.com:5432/solverr
DATABASE_URL=postgresql://solverr:solverr@localhost:5432/solverr
# PEM certificate from deploy/postgres-tls/ca.crt (on Vercel only): connections then use TLS and accept only that server
DATABASE_CA_CERT=
# The website's client certificate and key from deploy/postgres-tls/ (on Vercel only, set together); PgBouncer refuses connections without them
DATABASE_CLIENT_CERT=
DATABASE_CLIENT_KEY=
# Most database connections per process (optional; default 10). Use 5 on Vercel, where each function instance is a process.
DATABASE_POOL_MAX=

# Public base URL of this app
APP_URL=http://localhost:3002

# NEAR Intents 1Click API
ONECLICK_BASE_URL=https://1click.chaindefuser.com
# Partner key from partners.near-intents.org (optional; without it 1Click adds 0.25% per swap)
ONECLICK_API_KEY=
# Confidential Intents level for private payments: basic or advanced (optional; needs the partner key above; private payments are off without it)
ONECLICK_CONFIDENTIALITY=

# 32 random bytes, base64, used to encrypt webhook secrets and stored API responses. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# Signs sign-in sessions; at least 32 characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# NEAR RPC the server uses to check NEAR transfers and that a signing key is a full-access key of the account (sign-in, payout wallet)
NEAR_RPC_URL=https://free.rpc.fastnear.com
# Solana RPC the server uses to check transfers and read Earn vault balances (optional; defaults to https://api.mainnet-beta.solana.com)
SOLANA_RPC_URL=
# EVM RPCs the server uses to check transfers, smart-wallet sign-ins and Earn balances, as chainId=url pairs separated
# by commas, such as 8453=https://base.example,1=https://eth.example (optional; a chain left out uses its public RPC)
EVM_RPC_URLS=

# RPCs the browser uses for wallet balances and Solana payments (optional; default to the public endpoints).
# NEXT_PUBLIC_ values are built into the page and visible to everyone, so use a key restricted to this app's domain.
NEXT_PUBLIC_SOLANA_RPC_URL=
NEXT_PUBLIC_NEAR_RPC_URL=

# Email (optional). Both must be set to enable email sign-in and receipts; EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=

# Reown project id from dashboard.reown.com (required for the wallet modal: EVM, Solana, Bitcoin, TRON, TON; lets phone NEAR wallets connect by QR code)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Telegram bot (optional; both must be set). Token from @BotFather; the secret is a random string of at least 32 characters: openssl rand -hex 32
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# GlitchTip (or other Sentry-compatible) DSN for server and worker error reports (optional; off without it)
SENTRY_DSN=
