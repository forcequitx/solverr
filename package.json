{
  "name": "solverr",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs web",
    "build": "prisma generate && npm run build:embed && npm run build:plugin && next build",
    "build:embed": "cd packages/embed && npm ci --no-audit --no-fund && npm run build",
    "build:plugin": "node scripts/build-woocommerce-zip.mjs",
    "start": "node scripts/dev.mjs start",
    "worker": "node scripts/dev.mjs worker",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run --mode db",
    "test:e2e": "playwright test",
    "db:up": "docker compose -f deploy/docker-compose.dev.yml up -d --wait",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate"
  },
  "dependencies": {
