# Back-end settings for deploy/docker-compose.yml (worker, migrations, Caddy). Copy to deploy/.env on the server,
# fill in every value, and make it readable only by the deploy user: chmod 600 deploy/.env
# The website on Vercel has its own settings (README, "Deployment"); keep the shared values below identical there.

# Public address of the website on Vercel, used in emailed links, such as https://pay.example.com
APP_URL=

# Postgres connection used by the worker and migrations, as the limited solverr role over the server's Docker network;
# put the SOLVERR_DB_PASSWORD value from deploy/postgres.env after "solverr:"
DATABASE_URL=postgresql://solverr:@postgres:5432/solverr

# NEAR Intents 1Click server
ONECLICK_BASE_URL=https://1click.chaindefuser.com
# 1Click partner key from partners.near-intents.org (optional; without it 1Click adds 0.25% per swap)
ONECLICK_API_KEY=
# Confidential Intents level for private payments: basic or advanced (optional; needs the partner key above; private payments are off without it)
ONECLICK_CONFIDENTIALITY=

# NEAR RPC endpoint used to verify NEAR wallet sign-in and NEAR transfers
NEAR_RPC_URL=https://free.rpc.fastnear.com
# Solana RPC the server uses to check transfers and read Earn vault balances (optional; defaults to https://api.mainnet-beta.solana.com)
SOLANA_RPC_URL=
# EVM RPCs the server uses to check transfers, smart-wallet sign-ins and Earn balances, as chainId=url pairs separated
# by commas, such as 8453=https://base.example,1=https://eth.example (optional; a chain left out uses its public RPC)
EVM_RPC_URLS=

# Encrypts webhook secrets and stored API responses at rest: 32 random bytes, base64; the same value as on Vercel. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=
# Signs user sessions; the same value as on Vercel. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Resend API key for email delivery (optional; both must be set). Receipts, pay links and alerts are off without them.
RESEND_API_KEY=
# Sender address on the domain verified in Resend, such as Solverr <no-reply@example.com>
EMAIL_FROM=

# Telegram bot (optional; both must be set, with the same values as on Vercel). Token from @BotFather; the secret is a
# random string of at least 32 characters: openssl rand -hex 32
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# WAL archiving for point-in-time backups: off or on. Set it to on only after deploy/walg.env is filled in and
# "wal-g backup-push" works (README, "Point-in-Time Backups"), then run: docker compose -f deploy/docker-compose.yml up -d
PG_ARCHIVE_MODE=off

# Hostname of the GlitchTip error dashboard; Caddy gets a certificate for it. Point it at this server, for example
# errors.203-0-113-5.sslip.io. GlitchTip's own secrets go in deploy/glitchtip.env.
GLITCHTIP_HOST=
# DSN of the GlitchTip project for Solverr (optional; error reports are off without it). Copy the DSN from the project's
# settings and replace its https://…@<GLITCHTIP_HOST> part with http://…@glitchtip:8000, so the worker's reports stay on
# this server. The website on Vercel uses the DSN as copied.
SENTRY_DSN=
