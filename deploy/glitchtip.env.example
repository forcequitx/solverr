# GlitchTip error tracking (the glitchtip service in deploy/docker-compose.yml).
# Copy to deploy/glitchtip.env, fill in every value and run: chmod 600 deploy/glitchtip.env
# Kept apart from deploy/.env so the web and worker containers never receive these secrets.

# GlitchTip's database; put the GLITCHTIP_DB_PASSWORD value from deploy/postgres.env after "glitchtip:"
DATABASE_URL=postgres://glitchtip:@postgres:5432/glitchtip

# Signs GlitchTip sessions: openssl rand -hex 32
SECRET_KEY=

# Alert emails. With Resend: smtp://resend:<RESEND_API_KEY>@smtp.resend.com:587
EMAIL_URL=
# Sender address on the domain verified in Resend, such as GlitchTip <alerts@example.com>
DEFAULT_FROM_EMAIL=
