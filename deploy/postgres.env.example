# Database passwords for the postgres and db-roles services in deploy/docker-compose.yml, kept apart from deploy/.env so web, worker
# and PgBouncer never receive the superuser password (the website's is in deploy/pgbouncer.env). Copy to deploy/postgres.env, fill in
# every value and run: chmod 600 deploy/postgres.env. Use letters and digits only, so each fits in a connection URL: openssl rand -hex 32

# The postgres superuser, used only to create the roles below and for maintenance.
POSTGRES_PASSWORD=
# The solverr role that the worker and migrations log in as; put the same value into DATABASE_URL in deploy/.env.
SOLVERR_DB_PASSWORD=
# GlitchTip's role; put the same value into DATABASE_URL in deploy/glitchtip.env.
GLITCHTIP_DB_PASSWORD=
