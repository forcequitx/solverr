# WAL-G point-in-time backups (README, "Point-in-Time Backups"). Copy to deploy/walg.env, fill in every value and run:
# chmod 600 deploy/walg.env. Only the postgres service loads this file, so web and worker never receive these keys.

# Bucket and folder; keep one folder per Postgres major version.
# Cloudflare R2: s3://<bucket>/solverr-pg17   Backblaze B2: s3://<bucket>/solverr-pg17
WALG_S3_PREFIX=
# Cloudflare R2: https://<account id>.r2.cloudflarestorage.com   Backblaze B2: https://s3.<region>.backblazeb2.com
AWS_ENDPOINT=
# Cloudflare R2: auto   Backblaze B2: the bucket's region, such as us-west-004
AWS_REGION=
AWS_S3_FORCE_PATH_STYLE=true
# Access key limited to this bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Encrypts every backup and WAL file before it leaves the server: openssl rand -hex 32
# Store it in a password manager too; without it the backups cannot be restored.
WALG_LIBSODIUM_KEY=
WALG_LIBSODIUM_KEY_TRANSFORM=hex

# How WAL-G connects for base backups: the Unix socket inside the postgres container, as the superuser, because starting a
# base backup (pg_backup_start) needs it; the app's solverr role cannot. The socket needs no password.
PGHOST=/var/run/postgresql
PGUSER=postgres
PGDATABASE=postgres
