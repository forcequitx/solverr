# GlitchTip with current security fixes; the upstream image is rebuilt only with each GlitchTip release.
# Pinned by tag and digest; built by deploy/docker-compose.yml.
FROM glitchtip/glitchtip:6.2.6@sha256:a3d8eb1b36c1e1603d55ab32711ea3dd8115874742a781a57391a62a16e0dff6

USER root
RUN apt-get update \
 && apt-get upgrade -y --no-install-recommends \
 && rm -rf /var/lib/apt/lists/*

# Python packages that GlitchTip 6.2.6 ships with known vulnerabilities, each moved to a fixed release (fido2 and yarl
# so cryptography and aiohttp fit); oauthlib is removed because nothing requires it. `pip check` and Django's system
# check fail the build if the set no longer fits together. Revisit this list on every GlitchTip upgrade.
RUN pip install --no-cache-dir --no-deps --root-user-action=ignore \
      "PyJWT==2.14.0" "aiohttp==3.14.4" "anyio==4.14.2" "certifi==2026.10.18" "cryptography==50.0.0" \
      "dnspython==2.9.0" "fido2==2.2.1" "mcp==1.28.1" "msgpack==1.2.3" "pyasn1==0.6.5" "python-multipart==0.0.30" \
      "sqlparse==0.6.0" "starlette==1.3.1" "urllib3==2.8.0" "yarl==1.25.1" \
 && pip uninstall -y --root-user-action=ignore oauthlib \
 && pip check

# pip and setuptools are only needed to install and carry their own old copies of certifi, urllib3 and others; GlitchTip
# never calls them at runtime, so they are removed, and Django's system check confirms the app still loads.
RUN pip uninstall -y --root-user-action=ignore setuptools \
 && python -m pip uninstall -y --root-user-action=ignore pip \
 && rm -rf /usr/local/lib/python3.14/ensurepip/_bundled \
 && SECRET_KEY=build-check DATABASE_URL=postgres://build:build@localhost:1/build python manage.py check

# The upstream image runs as this user.
USER app:app
