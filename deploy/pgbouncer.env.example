# The website's database password, for the pgbouncer and db-roles services in deploy/docker-compose.yml. It sits apart from
# deploy/postgres.env so the internet-facing PgBouncer never receives the superuser's or the other roles' passwords.
# Copy to deploy/pgbouncer.env, fill in the value and run: chmod 600 deploy/pgbouncer.env

# The solverr_web role that the website on Vercel logs in as; letters and digits only (openssl rand -hex 32). Put the same
# value into DATABASE_URL on Vercel.
SOLVERR_WEB_DB_PASSWORD=
